fn I32 main() {
    println(2 + 3);
    println(2 + 3 + 4);

    println(2 - 3);
    println(3 - 2);
    println(2 - 3 - 4);

    println(2 * 3);
    println(-2 * 3);
    println(2 * -3);
    println(-2 * -3);
    println(2 * 3 * -4);

    println(4 / 3);
    println(3 / 3);
    println(3 / 4);
    println(-4 / 2);
    println(4 / -2);
    println(-4 / -2);
    println(4 / 2 / -2);
    println(4 / 2 / -2);

    println(4 % 4);
    println(4 % 3);
    println(4 % 5);
    println(-4 % 5);
    println(-4 % -5);
    println(4 % -5);
    println(-3 % 4 % 5);

    println(4 == 4);
    println(4 == 5);
    println(4 != 5);
    println(4 != 4);

    println(4 < 5);
    println(4 < 4);
    println(4 < 3);

    println(4 <= 5);
    println(4 <= 4);
    println(4 <= 3);

    println(4 > 5);
    println(4 > 4);
    println(4 > 3);

    println(4 >= 5);
    println(4 >= 4);
    println(4 >= 3);

    println(-(2 + 3) * 8 / 2 == -10 * 2);
}
